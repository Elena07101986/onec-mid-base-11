#Область ПрограммныйИнтерфейс
// Дорабатывает типовые формы программно при их создании на сервере.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - дорабатываемая форма.
//
Процедура ПриСозданииНаСервере(Форма) Экспорт
	
	// Начало. Нето. Точка входа программной доработки типовых форм
	ИмяФормы = Форма.ИмяФормы;
	Если ИмяФормы = "Справочник.Контрагенты.Форма.ФормаЭлемента" Тогда
		ДобавитьСписокКонтактныхЛиц(Форма);
	ИначеЕсли ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда
		ДобавитьЭлементыЗаказа(Форма);
	ИначеЕсли ИмяФормы = "Документ.ОплатаОтПокупателя.Форма.ФормаДокумента"
		Или ИмяФормы = "Документ.ОплатаПоставщику.Форма.ФормаДокумента"
		Или ИмяФормы = "Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокумента"
		Или ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		ДобавитьПолеКонтактноеЛицо(Форма);
	КонецЕсли;
	// Конец. Нето
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСписокКонтактныхЛиц(Форма)
	
	// Начало. Нето. Список контактных лиц на форме контрагента
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("Нето_СписокКонтактныхЛиц",
		Новый ОписаниеТипов("ДинамическийСписок"), , "Контактные лица"));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Список = Форма.Нето_СписокКонтактныхЛиц;
	Список.ОсновнаяТаблица = "Справочник.Нето_КонтактныеЛица";
	Список.ДинамическоеСчитываниеДанных = Истина;
	
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Форма.Объект.Ссылка;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.РежимОтображения =
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	Таблица = Форма.Элементы.Добавить("Нето_ТаблицаКонтактныхЛиц", Тип("ТаблицаФормы"));
	Таблица.ПутьКДанным = "Нето_СписокКонтактныхЛиц";
	Таблица.Заголовок = "Контактные лица";
	
	Колонка = Форма.Элементы.Добавить("Нето_КЛНаименование", Тип("ПолеФормы"), Таблица);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Нето_СписокКонтактныхЛиц.Наименование";
	
	Колонка = Форма.Элементы.Добавить("Нето_КЛДолжность", Тип("ПолеФормы"), Таблица);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Нето_СписокКонтактныхЛиц.Должность";
	
	Колонка = Форма.Элементы.Добавить("Нето_КЛТелефон", Тип("ПолеФормы"), Таблица);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Нето_СписокКонтактныхЛиц.КонтактныйТелефон";
	Колонка.Заголовок = "Телефон";
	// Конец. Нето
	
КонецПроцедуры

Процедура ДобавитьЭлементыЗаказа(Форма)
	
	// Начало. Нето. Поле скидки, контактное лицо и кнопка пересчета в заказе
	ГруппаШапка = Форма.Элементы.ГруппаШапкаПраво;
	
	ПолеСкидка = Форма.Элементы.Добавить("Нето_ПолеСогласованнаяСкидка", Тип("ПолеФормы"), ГруппаШапка);
	ПолеСкидка.Вид = ВидПоляФормы.ПолеВвода;
	ПолеСкидка.ПутьКДанным = "Объект.Нето_СогласованнаяСкидка";
	ПолеСкидка.Заголовок = "Согласованная скидка, %";
	ПолеСкидка.УстановитьДействие("ПриИзменении", "Нето_СогласованнаяСкидкаПриИзменении");
	
	ПолеКонтактноеЛицо = Форма.Элементы.Добавить("Нето_ПолеКонтактноеЛицо", Тип("ПолеФормы"), ГруппаШапка);
	ПолеКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКонтактноеЛицо.ПутьКДанным = "Объект.Нето_КонтактноеЛицо";
	ПолеКонтактноеЛицо.Заголовок = "Контактное лицо";
	
	Команда = Форма.Команды.Добавить("Нето_КомандаПересчитатьТаблицы");
	Команда.Заголовок = "Пересчитать таблицу";
	Команда.Действие = "Нето_ПересчитатьТаблицы";
	
	Кнопка = Форма.Элементы.Добавить("Нето_КнопкаПересчитать", Тип("КнопкаФормы"), ГруппаШапка);
	Кнопка.ИмяКоманды = "Нето_КомандаПересчитатьТаблицы";
	// Конец. Нето
	
КонецПроцедуры

Процедура ДобавитьПолеКонтактноеЛицо(Форма)
	
	// Начало. Нето. Поле контактного лица с отбором по контрагенту документа
	ПолеКонтактноеЛицо = Форма.Элементы.Добавить("Нето_ПолеКонтактноеЛицо", Тип("ПолеФормы"));
	ПолеКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКонтактноеЛицо.ПутьКДанным = "Объект.Нето_КонтактноеЛицо";
	ПолеКонтактноеЛицо.Заголовок = "Контактное лицо";
	// Конец. Нето
	
КонецПроцедуры

#КонецОбласти
